{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/ecommerce-frontend/browser",
    "functions": {
        "api/ssr.mjs": {
            "includeFiles": "dist/ecommerce-frontend/**",
            "maxDuration": 15
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://ecommerce-backend-sv5n.onrender.com/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/api/ssr"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "Content-Security-Policy-Report-Only",
                    "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://*.paypal.com https://*.paypalobjects.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.stripe.com https://*.paypal.com https://*.paypalobjects.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://js.stripe.com https://hooks.stripe.com https://*.paypal.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.paypal.com; object-src 'none'"
                }
            ]
        }
    ]
}
